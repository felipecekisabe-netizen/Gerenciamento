<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Quiz1Activity">

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible"
            tools:visibility="visible">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="                                            Pergunta 1: Como morcegos se orientam? "
                android:textSize="24sp" />

            <Button
                android:id="@+id/p1o1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ecolocaliza_o" />

            <Button
                android:id="@+id/p1o2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vis_o_noturna" />

            <Button
                android:id="@+id/p1o3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/olfato" />

            <Button
                android:id="@+id/p1o4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/magnetismo" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pergunta 2: Qual animal tem a maior pressão sanguínea?"
                android:textSize="24sp" />

            <Button
                android:id="@+id/p2o1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/elefante" />

            <Button
                android:id="@+id/p2o2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/humano" />

            <Button
                android:id="@+id/p2o3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Girafa" />

            <Button
                android:id="@+id/p2o4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chita" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pergunta 3: Quantas espécies de gatos selvagens existem?"
                android:textSize="24sp" />

            <Button
                android:id="@+id/p3o1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="53" />

            <Button
                android:id="@+id/p3o2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="38" />

            <Button
                android:id="@+id/p3o3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="29" />

            <Button
                android:id="@+id/p3o4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="41" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pergunta 4: Qual é a ave mais rápida do mundo?"
                android:textSize="24sp" />

            <Button
                android:id="@+id/p4o1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Águia Dourada" />

            <Button
                android:id="@+id/p4o2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Falcão-peregrino" />

            <Button
                android:id="@+id/p4o3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ganso-de-esporão" />

            <Button
                android:id="@+id/p4o4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Falcão-sacar" />

            <TextView
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pergunta 5: Quantas penas, em média, tem a cauda de um pavão?"
                android:textSize="24sp" />

            <Button
                android:id="@+id/p5o1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150" />

            <Button
                android:id="@+id/p5o2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="200" />

            <Button
                android:id="@+id/p5o3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="300" />

            <Button
                android:id="@+id/p5o4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="500" />

            <TextView
                android:id="@+id/textView7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="                                   -               "
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnResultados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/finalizar" />

            <TextView
                android:id="@+id/textView11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="                                                                                                                                                                                   -               "
                android:textSize="24sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>