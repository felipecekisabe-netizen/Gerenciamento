                android:id="@+id/p4o4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Linky" />

            <TextView
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pergunta 5: Devil May Cry começou desenvolvimento como uma sequência para outra franquia, essa franquia é?"
