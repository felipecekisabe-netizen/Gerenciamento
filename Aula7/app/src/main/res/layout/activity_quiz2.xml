<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Quiz1Activity">

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible"
            tools:visibility="visible">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="                                            Pergunta 1: Qual console foi pioneiro de controles de movimento?"
                android:textSize="24sp" />

            <Button
                android:id="@+id/p1o1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Playstation 3" />

            <Button
                android:id="@+id/p1o2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nintendo Wii" />

            <Button
                android:id="@+id/p1o3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xbox 360" />

            <Button
                android:id="@+id/p1o4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nintedo Ds" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pergunta 2: Qual franquia tem o mesmo nome de uma música da Beyonce?"
                android:textSize="24sp" />

            <Button
                android:id="@+id/p2o1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Halo" />

            <Button
                android:id="@+id/p2o2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Judgment" />

            <Button
                android:id="@+id/p2o3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Burnout" />

            <Button
                android:id="@+id/p2o4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Control" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pergunta 3: Qual dessas opções é o subtítulo de um dos jogos da série Super Smash Bros?"
                android:textSize="24sp" />

            <Button
                android:id="@+id/p3o1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Infinite" />

            <Button
                android:id="@+id/p3o2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rumble" />

            <Button
                android:id="@+id/p3o3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Legends" />

            <Button
                android:id="@+id/p3o4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brawl" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pergunta 4: os 4 fantasmas de Pac-Man se chamam Inky, Blinky, Pinky e?"
                android:textSize="24sp" />

            <Button
                android:id="@+id/p4o1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dinky" />

            <Button
                android:id="@+id/p4o2"
                android:layout_width="wrap_content"
